{
    "name": "puneetpal/laravel-device-tokens",
    "description": "Per-device Laravel Sanctum tokens for first-party iOS and Android apps: one token per device, expiry on every token, atomic rotation, and per-device revocation.",
    "keywords": [
        "laravel",
        "sanctum",
        "mobile",
        "ios",
        "android",
        "api",
        "tokens",
        "authentication",
        "device-tokens",
        "token-rotation"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/puneetpals271/laravel-device-tokens",
    "authors": [
        {
            "name": "Puneetpal Arneja",
            "homepage": "https://puneetpal.dev",
            "role": "Author"
        }
    ],
    "support": {
        "issues": "https://github.com/puneetpals271/laravel-device-tokens/issues",
        "source": "https://github.com/puneetpals271/laravel-device-tokens",
        "security": "https://github.com/puneetpals271/laravel-device-tokens/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Puneetpal\\DeviceTokens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Puneetpal\\DeviceTokens\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Puneetpal\\DeviceTokens\\DeviceTokensServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
